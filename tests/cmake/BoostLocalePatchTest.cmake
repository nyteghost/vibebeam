cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${TEST_ROOT}/libs/locale/include/boost/locale")
file(WRITE "${TEST_ROOT}/libs/locale/include/boost/locale.hpp" "")
file(WRITE "${TEST_ROOT}/libs/locale/include/boost/locale/generator.hpp" "")
set(fixture [=[cmake_minimum_required(VERSION 3.20)
project(BoostLocaleGrouping NONE)
set(sources_inc include/boost/locale.hpp include/boost/locale/generator.hpp)
source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}/include/boost/locale" PREFIX "headers" FILES ${sources_inc})
source_group("headers" FILES "include/boost/locale.hpp")
]=])
set(source "${TEST_ROOT}/libs/locale/CMakeLists.txt")
file(WRITE "${source}" "${fixture}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/libs/locale" -B "${TEST_ROOT}/before"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(result EQUAL 0)
    message(STATUS "This CMake accepts the old lexical prefix; current CMake requires a parent directory")
elseif(NOT error MATCHES "is not a prefix of file")
    message(FATAL_ERROR "Unexpected failure in the unpatched fixture: ${error}")
else()
    message(STATUS "Reproduced the Boost.Locale source_group failure")
endif()
set(patch "${REPO}/cmake/dependencies/PatchBoostLocale.cmake")
foreach(attempt RANGE 1 2)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DBOOST_SOURCE_DIR=${TEST_ROOT}" -P "${patch}"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Boost.Locale patch failed on attempt ${attempt}")
    endif()
    file(READ "${source}" patched)
    if(attempt EQUAL 2 AND NOT patched STREQUAL first_patch)
        message(FATAL_ERROR "Boost.Locale patch is not idempotent")
    endif()
    set(first_patch "${patched}")
endforeach()
set(expected [=[source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}/include/boost" PREFIX "headers" FILES ${sources_inc})]=])
string(FIND "${patched}" "${expected}" fixed_position)
if(fixed_position EQUAL -1)
    message(FATAL_ERROR "Header group must use the common parent of locale.hpp and locale/")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/libs/locale" -B "${TEST_ROOT}/after"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Patched Boost.Locale header grouping did not configure")
endif()
file(WRITE "${source}" "# Unexpected upstream content\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DBOOST_SOURCE_DIR=${TEST_ROOT}" -P "${patch}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(READ "${source}" unexpected)
if(result EQUAL 0 OR NOT unexpected STREQUAL "# Unexpected upstream content\n")
    message(FATAL_ERROR "Patch must refuse unexpected upstream content without writing it")
endif()
